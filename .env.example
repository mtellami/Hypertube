# Copy to .env (never commit .env) and fill in the values.

# --- Core -------------------------------------------------------------------
# Long random string, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# URL users open in the browser (used for OAuth callbacks and password-reset links)
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
# Production only (docker-compose.prod.yml, see DEPLOY.md): public domain served over HTTPS
DOMAIN=
# Other public addresses of this same instance (comma-separated), e.g. a Cloudflare tunnel
# domain: https://hypertube.example.com  (OAuth/reset links follow the address used)
EXTRA_PUBLIC_URLS=
# Cloudflare tunnel token for `docker compose --profile tunnel up -d`
CLOUDFLARE_TUNNEL_TOKEN=

# --- Database ---------------------------------------------------------------
POSTGRES_DB=hypertube
POSTGRES_USER=hypertube
POSTGRES_PASSWORD=

# --- Mail (defaults use the bundled Mailpit, inbox at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
MAIL_FROM=Hypertube <no-reply@hypertube.local>

# --- OAuth providers ----------------------------------------------------------
# 42: https://profile.intra.42.fr/oauth/applications/new
#     Redirect URI: http://localhost:8080/api/auth/oauth/42/callback
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> New OAuth App
#     Authorization callback URL: http://localhost:8080/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Bonus providers (buttons appear only when configured)
# Discord: https://discord.com/developers/applications -> New Application -> OAuth2
#     Redirect: http://localhost:8080/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# GitLab: https://gitlab.com/-/user_settings/applications (scope: read_user)
#     Redirect URI: http://localhost:8080/api/auth/oauth/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --- Metadata & subtitles -----------------------------------------------------
# TMDb (free): https://www.themoviedb.org/settings/api  (v3 API key or v4 read access token)
TMDB_API_KEY=
# OpenSubtitles (optional, more languages): https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --- Sources / streaming ------------------------------------------------------
# PeerTube instances whose videos are published by their rights holders (comma-separated)
PEERTUBE_INSTANCES=video.blender.org
# Bytes that must be buffered before playback starts
STREAM_READY_BYTES=8388608
UNWATCHED_RETENTION_DAYS=30
